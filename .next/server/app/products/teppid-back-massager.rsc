19:["$","$L23",null,{"children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Product\",\"name\":\"Teppid Back Massager\",\"description\":\"Electric back massager with shiatsu kneading nodes, heat therapy and adjustable straps for use on chairs.\",\"image\":[\"https://www.avatraders.in/images/products/health-care-products/teppid-back-massager/1.jpg\",\"https://www.avatraders.in/images/products/health-care-products/teppid-back-massager/2.jpg\",\"https://www.avatraders.in/images/products/health-care-products/teppid-back-massager/3.jpg\"],\"sku\":\"teppid-back-massager\",\"brand\":{\"@type\":\"Brand\",\"name\":\"AVA Traders\"},\"offers\":{\"@type\":\"Offer\",\"url\":\"https://www.avatraders.in/products/teppid-back-massager\",\"priceCurrency\":\"INR\",\"price\":4999,\"availability\":\"https://schema.org/InStock\",\"seller\":{\"@type\":\"Organization\",\"name\":\"AVA Traders\"}}}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Can I use it in my car?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes, the Teppid Back Massager comes with a car adapter so you can use it during commutes or long drives.\"}},{\"@type\":\"Question\",\"name\":\"Is it safe to use with heat therapy?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes, the infrared heat is mild and the 15-minute auto shut-off prevents overheating.\"}},{\"@type\":\"Question\",\"name\":\"Will it fit my office chair?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes, the adjustable straps fit most standard office chairs, dining chairs and car seats.\"}}]}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"posi