10:T759,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Where is the AVA Traders showroom located?","acceptedAnswer":{"@type":"Answer","text":"Our showroom is at Padmabati Complex, #3068/10236, Puri Bypass Road, Badagada, Bhubaneswar - 751018, Odisha. You're welcome to visit and try any massage chair or device before buying."}},{"@type":"Question","name":"Can I try a massage chair before purchasing?","acceptedAnswer":{"@type":"Answer","text":"Yes. Every massage chair and major device we sell is on display at our showroom so you can sit in it, test the programs, and compare models side by side before making a decision."}},{"@type":"Question","name":"Do you offer home delivery and installation?","acceptedAnswer":{"@type":"Answer","text":"Yes, we deliver across Bhubaneswar and can arrange delivery to other parts of Odisha. For massage chairs, our team assists with in-home setup and a walkthrough of the controls."}},{"@type":"Question","name":"What warranty do your products come with?","acceptedAnswer":{"@type":"Answer","text":"Warranty varies by product and is listed on each product page — typically 6 months to 2 years. We handle warranty claims directly from our showroom, so you're not stuck dealing with a distant call centre."}},{"@type":"Question","name":"How do I place an enquiry or order?","acceptedAnswer":{"@type":"Answer","text":"You can call us, message us on WhatsApp, or fill out the enquiry form on any product page. Our team will confirm stock and pricing and guide you through the rest."}},{"@type":"Question","name":"Do you sell genuine, certified products?","acceptedAnswer":{"@type":"Answer","text":"Yes, we source from established manufacturers and the electronics we stock carry standard safety certifications such as CE, FCC and RoHS where applicable. Details are listed on individual product pages."}}]}c:["$","$1","c",{"children":[[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html